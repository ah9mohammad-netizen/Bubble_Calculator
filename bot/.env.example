TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here
TELEGRAM_CHAT_ID=123456789
DATA_DIR=/data
CHECK_INTERVAL_MIN=60
REPORT_HOUR_TEHRAN=12

# --- cost controls (Railway bills RAM+CPU hours, not repo size) ---
# Poll interval in minutes during Tehran market hours. Outside 08:00-20:00
# the bot automatically sleeps 4x longer.
CHECK_INTERVAL_MIN=120
# Telegram long-poll seconds. Higher = fewer reconnects = less CPU.
LONGPOLL_SEC=50
# Set to 0 to disable the command listener entirely and only receive the
# daily digest. This removes one of the two always-on threads.
ENABLE_COMMANDS=1
